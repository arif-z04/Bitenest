# ====================================================================
# Git Attributes - Cross-Platform Line Ending Normalization
# ====================================================================

# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.cs text diff=csharp eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.csproj text eol=lf

# Explicit binary files
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
