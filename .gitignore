# ====================================================================
# BiteNest .gitignore Configuration
# ====================================================================

# --------------------------------------------------------------------
# .NET Core & C# Build Artifacts
# --------------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/
out/
publish/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.pidb
*.booproj
*.svclog

# Visual Studio / Rider / Omnisharp
.vs/
.idea/
*.DotSettings.user
_ReSharper*/
*.rsuser

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --------------------------------------------------------------------
# Configuration & Sensitive Data
# --------------------------------------------------------------------
appsettings.Production.json
*.local.json
secrets.json
.env
.env.local
.env.*.local

# --------------------------------------------------------------------
# Node.js & Frontend Assets
# --------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.cache/

# --------------------------------------------------------------------
# Python Virtual Environments & Bytecode
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --------------------------------------------------------------------
# Test & Coverage Outputs
# --------------------------------------------------------------------
TestResults/
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml

# --------------------------------------------------------------------
# Operating System Files
# --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------------------------------
# Docker & Database local data
# --------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.log
mysql_data/
